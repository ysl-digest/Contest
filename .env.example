# 로컬 실행용 예시. 실제 값은 .env(커밋 금지)나 셸 환경변수로 넣으세요.
OPENROUTER_API_KEY=
# 비우면 config.py 기본값 사용
VLM_MODEL=google/gemini-2.5-flash-lite
VLM_FALLBACK_MODEL=anthropic/claude-haiku-5.5
MAX_ITEMS=40
MAX_POSTERS=2
MAX_PAGES=3
REQUEST_DELAY=2.0
# Issue 생성용 (dry-run에는 불필요). ISSUE_TOKEN이 있으면 우선 사용
ISSUE_TOKEN=
GITHUB_REPOSITORY=yeseoLee/Contest-Subscribe
