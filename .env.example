# 로컬 실행용 예시. 실제 값은 .env(커밋 금지)나 셸 환경변수로 넣으세요.
OPENROUTER_API_KEY=
# 비우면 config.py 기본값 사용
VLM_MODEL=qwen/qwen3.7-flash
VLM_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash
# IT 주제 분류 (목록 메타데이터만 배치로 전송)
CLASSIFIER_MODEL=typesafe/jev-router
CLASSIFIER_FALLBACK_MODEL=qwen/qwen3.5-9b
CLASSIFY_BATCH=40
MAX_ITEMS=40
MAX_POSTERS=2
MAX_PAGES=5
REQUEST_DELAY=2.0
# Issue 생성용 (dry-run에는 불필요). ISSUE_TOKEN이 있으면 우선 사용
ISSUE_TOKEN=
GITHUB_REPOSITORY=yeseoLee/Contest-Subscribe
